<%- include('includes/header') %> <%- include('includes/nav') %>
<div class="container">
  <div class="row">
    <div class="col-2"></div>
    <div class="col-8">
      <h1 class="text-center my-4">Contato</h1>
      <p class="text-center lead">Crie ou edite seu contato.</p>

      <%- include('includes/messages') %>
      <% if (contato._id)  { %>
        <form action="/contatos/<%= contato._id %>" method="POST">
      <% } else { %>
        <form action="/contatos" method="POST">
      <% } %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="form-group">
          <label>Nome</label>
          <input value="<%= contato.nome %>" name="nome" type="text" class="form-control" />
        </div>
        <div class="form-group">
          <label>Sobrenome</label>
          <input value="<%= contato.sobrenome %>" name="sobrenome" type="text" class="form-control" />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input value="<%= contato.email %>" name="email" type="email" class="form-control" />
        </div>
        <div class="form-group">
          <label>Telefone</label>
          <input value="<%= contato.telefone %>" name="telefone" type="tel" class="form-control" />
        </div>
        
        <button type="submit" class="btn btn-primary">Salvar</button>
      </form>
    </div>
    <div class="col-2"></div>
  </div>
</div>
<%- include('includes/footer') %>
