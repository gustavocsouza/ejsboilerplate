<%- include('includes/header') %> 
<%- include('includes/nav') %>
<div class="container">
  <div class="row">
    <div class="col-2"></div>
    <div class="col-8">
      <h1 class="text-center my-4">Agenda</h1>
      <p class="text-center lead">Seus contatos:</p>
      
      <%- include('includes/messages') %>

      <% if (contatos.length) { %>
      <div class="responsive-table my-3">
        <table class="table">
          <% contatos.forEach(contato => { %>
            <tr>
              <td><%= contato.nome %></td>
              <td><%= contato.sobrenome %></td>
              <td><%= contato.email %></td>
              <td><%= contato.telefone %></td>
              <td><a href="/contatos/<%= contato._id %>">Editar</a></td>
              <td><a class="text-danger" href="/contatos/delete/<%= contato._id %>">Excluir</a></td>
            </tr>
            <% }) %>
          </table>
        </div>
      <% } else { %>
        <p class="text-center lead">Não existem contatos na sua agenda.</p>
      <% } %>
    </div>
    <div class="col-2"></div>
  </div>
</div>
<%- include('includes/footer') %>
