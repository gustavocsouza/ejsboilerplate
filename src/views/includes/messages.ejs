<% if (errors.length) { %>
  <div class="row">
    <div class="col">
      <div class="alert alert-danger">
        <% errors.forEach(error => { %>
          <%= error %><br>
        <% }); %>
      </div>
    </div>
  </div>
<% } %>

<% if (success.length) { %>
  <div class="row">
    <div class="col">
      <div class="alert alert-success">
        <% success.forEach(message => { %>
          <%= message %><br>
        <% }); %>
      </div>
    </div>
  </div>
<% } %>